{
  "compilerOptions": {
    "types": [
      "react",
      "react-dom",
      "node",
      "webmidi",
      "wicg-file-system-access",
      "web-bluetooth",
      "vite-plugin-svgr/client"
    ],
    "sourceMap": true,
    "target": "esnext",
    "module": "es2015",
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@emotion/react",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": true,
    "lib": ["es2023", "dom", "ESNext.Collection"],
    "strictNullChecks": true,
    "alwaysStrict": true,
    "useDefineForClassFields": true,
    "resolveJsonModule": true,
    // Vite does the emitting; tsc only type-checks. This lets the app import
    // packages whose sources use explicit .ts specifiers (tonemap-core runs
    // its CLI through node --experimental-strip-types, which requires them).
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "paths": {
      // Avoid referencing the node_modules of the library when developing a local library.
      "@types/react": ["../node_modules/@types/react"]
    }
  },
  "include": ["src/**/*"]
}
