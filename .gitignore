.grunt

# node-waf configuration
.lock-wscript

# Compiled binary addons (http://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules
jspm_packages

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

static/bundle.js
esdoc
pkg
build
dist

*.env
*.provisionprofile
.turbo
*.pfx

# JetBrains data
.idea

# MUSE ToneMap: private reference material and derived caches.
# Reference recordings and hand-reconstructed MIDI are never committed —
# only manifests, schemas, code and synthetic fixtures are.
private-assets/*
!private-assets/README.md
reference-audio/
reference-midi/
analysis-cache/
render-cache/

# Copied from electron/assets at build time, not a second copy in git
app/public/soundfonts/
